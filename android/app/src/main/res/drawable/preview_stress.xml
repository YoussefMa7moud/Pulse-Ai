<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background: Base deep dark gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0B1120"
                android:endColor="#111827"
                android:angle="135"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Background: Subtle rose glow from top-right -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#33F43F5E"
                android:endColor="#00000000"
                android:angle="225"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Background: Thin border stroke -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="0.5dp"
                android:color="#33F43F5E" />
            <corners android:radius="20dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- Preview: Centered accent ring -->
    <item
        android:gravity="center"
        android:width="80dp"
        android:height="80dp">
        <shape
            android:shape="ring"
            android:innerRadiusRatio="2.5"
            android:thicknessRatio="9"
            android:useLevel="false">
            <solid android:color="#F43F5E" />
        </shape>
    </item>

</layer-list>
