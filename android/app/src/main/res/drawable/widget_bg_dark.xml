<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: Base deep dark gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#0B1120"
                android:endColor="#111827"
                android:angle="135"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Layer 2: Subtle rose glow from top-right -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#33F43F5E"
                android:endColor="#00000000"
                android:angle="225"
                android:type="linear" />
            <corners android:radius="20dp" />
        </shape>
    </item>

    <!-- Layer 3: Thin border stroke with rose accent -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="0.5dp"
                android:color="#33F43F5E" />
            <corners android:radius="20dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

</layer-list>
