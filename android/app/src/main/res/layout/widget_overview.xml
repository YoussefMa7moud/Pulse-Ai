<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_vitals">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/vector_recovery_bg"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true">

                <TextView
                    android:id="@+id/widget_logo_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PULSE"
                    android:textColor="#06B6D4"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/widget_bg_shape"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HEALTH GLANCE"
                    android:textColor="#E2E8F0"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAILY VITALITY"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold"
                android:layout_alignParentEnd="true"
                android:letterSpacing="0.05" />
        </RelativeLayout>

        <!-- 4 Health Pillars (Recovery, Strain, Sleep, Stress) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Pillar 1: RECOVERY -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_pillar_bg_recovery"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:layout_marginEnd="4dp">

                <TextView
                    android:id="@+id/label_rec"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RECOVERY"
                    android:textColor="#22D3EE"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/overview_recovery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/overview_rec_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Score"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginBottom="4dp" />

                <ProgressBar
                    android:id="@+id/recovery_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_bar_cyan" />
            </LinearLayout>

            <!-- Pillar 2: STRAIN -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_pillar_bg_strain"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:layout_marginEnd="4dp">

                <TextView
                    android:id="@+id/label_strain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STRAIN"
                    android:textColor="#F97316"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/overview_strain"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/overview_strain_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="/ 21.0"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginBottom="4dp" />

                <ProgressBar
                    android:id="@+id/strain_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:indeterminate="false"
                    android:max="210"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_bar_orange" />
            </LinearLayout>

            <!-- Pillar 3: SLEEP -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_pillar_bg_sleep"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:layout_marginEnd="4dp">

                <TextView
                    android:id="@+id/label_sleep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SLEEP"
                    android:textColor="#818CF8"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/overview_sleep"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/overview_sleep_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quality"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginBottom="4dp" />

                <ProgressBar
                    android:id="@+id/sleep_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_bar_purple" />
            </LinearLayout>

            <!-- Pillar 4: STRESS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_pillar_bg_stress"
                android:padding="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/label_stress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STRESS"
                    android:textColor="#F43F5E"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/overview_stress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/overview_stress_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Balance"
                    android:textColor="#94A3B8"
                    android:textSize="9sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginBottom="4dp" />

                <ProgressBar
                    android:id="@+id/stress_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_bar_red" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
