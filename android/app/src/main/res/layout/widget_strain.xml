<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_strain"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="78dp"
            android:layout_height="78dp">

            <ProgressBar
                android:id="@+id/strain_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:indeterminate="false"
                android:max="21"
                android:progress="0"
                android:progressDrawable="@drawable/widget_circular_progress_blue" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_strain_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#F97316"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STRAIN"
                    android:textAllCaps="true"
                    android:textColor="#9CA3AF"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

            </LinearLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/widget_strain_calories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="-- kcal"
            android:textColor="#6B7280"
            android:textSize="11sp" />

    </LinearLayout>

</FrameLayout>
